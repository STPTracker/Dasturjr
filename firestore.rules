rules_version = '2';

// ============================================================
// VeriTap — Firestore Security Rules (class-project / no-backend edition)
// ------------------------------------------------------------
// Deploy: Firebase Console → Firestore Database → Rules tab → paste → Publish
//
// Architecture actually used by this build (important to understand):
//  - There is NO Cloud Function here. The scanner device (phone) is not
//    an admin — it signs in anonymously (a free, built-in Firebase Auth
//    method) purely so `request.auth != null` is true, which these rules
//    use as "this is some real app session, not a random bot request."
//  - Admins/teachers sign in with real email+password and get elevated
//    permissions via their /admins/{uid} document's `role` field.
//  - Because there's no server verifying NFC/WebAuthn results, a
//    technically sophisticated visitor COULD write a fake attendance
//    record directly against these rules. That's an accepted tradeoff
//    for a no-backend class project — call it out in your presentation
//    as a known limitation, and see FIREBASE_SETUP.md step 6 for the
//    Cloud-Function-verified upgrade path for a real deployment.
// ============================================================

function isSignedIn() {
  return request.auth != null;
}

function adminDoc() {
  return get(/databases/$(database)/documents/admins/$(request.auth.uid));
}

function isAdmin() {
  return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
    && adminDoc().data.role in ['super_admin', 'admin'];
}

function isSuperAdmin() {
  return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
    && adminDoc().data.role == 'super_admin';
}

function isTeacher() {
  return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
    && adminDoc().data.role == 'teacher';
}

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Students ----
    match /students/{studentId} {
      // Admins/teachers read everything. Anyone signed in (including the
      // anonymous scanner) can read too — the scanner has to look students
      // up by NFC card to identify who just tapped in.
      allow read: if isAdmin() || isTeacher() || isSignedIn() ||
        (resource.data.pendingRegistrationToken != null);

      allow create, update: if isAdmin() || (
        // Self-registration path: only when a pending token exists, the
        // write clears it (single-use) and sets only the credential fields.
        resource.data.pendingRegistrationToken != null &&
        request.resource.data.pendingRegistrationToken == null &&
        request.resource.data.hasCredential == true &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['hasCredential', 'credentialId', 'credentialRegisteredAt', 'pendingRegistrationToken'])
      );
      allow delete: if isSuperAdmin();

      match /credentials/{credentialId} {
        allow read: if isAdmin();
        allow write: if false; // unused by the current client-only flow
      }
    }

    // ---- Attendance ----
    // Written directly by the scanner (anonymous) rather than a Cloud
    // Function — see the architecture note above.
    match /attendance/{attendanceId} {
      allow read: if isAdmin() || isTeacher();
      allow create: if isSignedIn() && request.resource.data.keys().hasAll(
        ['studentId', 'sessionId', 'nfcResult', 'biometricResult', 'status', 'ts', 'deviceId']);
      allow update, delete: if isAdmin(); // manual corrections only
    }

    match /attendanceCorrections/{correctionId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // immutable
    }

    // ---- Live scan broadcast (for the guest/second-screen display) ----
    // Public read (the laptop display page has no login) — write only
    // needs a signed-in session (the scanner), not admin.
    match /liveScan/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ---- Sessions ----
    match /sessions/{sessionId} {
      allow read: if isAdmin() || isTeacher() || isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    // ---- Admins / teachers ----
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // ---- Devices ----
    match /devices/{deviceId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // ---- Security logs (append-only) ----
    match /securityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn(); // scanner logs failed/duplicate attempts
      allow update, delete: if false;
    }

    // ---- Settings ----
    match /settings/{settingId} {
      allow read: if isAdmin() || isTeacher() || isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
